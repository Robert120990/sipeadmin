# ==============================================================================
# SIPEOFI Backend Environment Variables Template
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5001

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:5173,https://admin.sipesv.com

# JWT Secret (MUST be a strong, cryptographically random string in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Primary Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=db_sipe_admin
# Alternatively, specify DATABASE_URL=mysql://user:password@host:port/database

# External System Database (Optional override)
EXTERNAL_DB_HOST=127.0.0.1
EXTERNAL_DB_PORT=3306
EXTERNAL_DB_USER=root
EXTERNAL_DB_PASSWORD=your_external_db_password
EXTERNAL_DB_NAME=db_system_rrs

# Google Gemini API Key (Required for AI financial assistant & chat)
GEMINI_API_KEY=your_gemini_api_key_here

# OneDrive Share Link for backup inspections (Optional)
ONEDRIVE_SHARE_LINK=https://onedrive.live.com/...

# Webhook Secret (Used by webhook-server.js to verify GitHub push signatures)
WEBHOOK_SECRET=your_github_webhook_secret_here
WEBHOOK_PORT=7778
AUTO_UPDATE_BRANCH=main

# Email Notifications (Optional - typically loaded from email_configs table in DB)
# SMTP_ALLOW_SELF_SIGNED=false
